# Copy this file to .env and fill in your own values. .env is
# git-ignored - never commit your real secrets.

# From your Supabase project: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Any long random string - signs student/teacher login sessions.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=3000
