# Copy this file to .env and fill in your own values. .env is
# git-ignored - never commit your real secrets.

# From your Supabase project: Project Settings -> API. This is used
# purely as storage - there are no user accounts in this app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Choose your own passcode - this is the one secret that unlocks the
# teacher dashboard. Students never need a passcode.
TEACHER_PASSCODE=replace-with-your-own-passcode

PORT=3000
